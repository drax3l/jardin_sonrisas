<div class="login-wrapper fade-in">
    <div class="login-container student-theme">
        
        <div class="login-header">
            <h1>🎒 Aula Virtual</h1>
            <p>Consulta de Notas, Pagos y Tareas</p>
        </div>

        <form action="/access" method="POST" class="login-form">
            
            <input type="hidden" name="tipo" value="estudiante">

            <% if (typeof error !== 'undefined') { %>
                <div style="background-color: #ffebee; color: #c62828; padding: 10px; border-radius: 8px; font-size: 0.9rem; text-align: center; border: 1px solid #ef9a9a;">
                    <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <div class="form-group">
                <label>Correo Electrónico</label>
                <input type="email" name="email" placeholder="sofia@jardin.pe" required>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-login btn-student">
                Entrar a mi Aula
            </button>

            <div class="help-links">
                <a href="#">¿Olvidaste tu contraseña?</a>
            </div>
        </form>
    </div>
</div>