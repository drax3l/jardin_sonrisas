<div class="login-wrapper fade-in">
    <div class="login-container teacher-theme"> <div class="login-header">
            <h1>🎓 Intranet Docente</h1>
            <p>Gestión de Notas y Asistencias</p>
        </div>

        <form action="/access" method="POST" class="login-form">
            
            <input type="hidden" name="tipo" value="docente">

            <% if (typeof error !== 'undefined') { %>
                <div style="background-color: #f3e5f5; color: #7b1fa2; padding: 10px; border-radius: 8px; font-size: 0.9rem; text-align: center; border: 1px solid #ce93d8; margin-bottom: 15px;">
                    <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <div class="form-group">
                <label>Correo Institucional</label>
                <input type="email" name="email" placeholder="carlos@jardin.pe" required>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-login btn-teacher">
                Ingresar al Sistema
            </button>

            <div class="help-links">
                <a href="#">Recuperar acceso</a>
            </div>
        </form>
    </div>
</div>